// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// 1. DESTINATIONS & PAGES PAYS (NOUVEAU)
// ------------------------------------------------------
model Destination {
  id               String      @id @default(cuid())
  name             String      @unique
  slug             String      @unique
  heroVideoUrl     String?  
  tagline          String?  
  presentationImg  String?  
  description      String      @db.Text
  
  // RELATIONS : Un pays a plusieurs types de voyages
  groupTrips       GroupTrip[] 
  soloTrips        SoloTrip[]  

  isPublished      Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

// ------------------------------------------------------
// 2. VOYAGES INDIVIDUELS / CIRCUITS TYPES (NOUVEAU)
// ------------------------------------------------------
model SoloTrip {
  id            String      @id @default(cuid())
  title         String
  slug          String      @unique
  description   String      @db.Text
  duration      Int         
  priceBase     Int         
  imageUrl      String?
  
  // Relation avec la destination
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  isPublished   Boolean     @default(true)
  createdAt     DateTime    @default(now())
}

// ------------------------------------------------------
// 3. VOYAGES DE GROUPE (Modifié pour la relation)
// ------------------------------------------------------
model GroupTrip {
  id              Int         @id @default(autoincrement())
  title           String
  slug            String      @unique 
  country         String?
  
  // Relation optionnelle avec Destination
  destinationId   String?
  destination     Destination? @relation(fields: [destinationId], references: [id])

  flyerUrl        String?      
  heroVideoUrl    String?      
  description     String      @db.Text
  program         Json        
  
  startDate       DateTime
  endDate         DateTime
  capacity        Int         
  
  priceBase       Float       
  pricePremium    Float       
  pricePlatinum   Float       
  
  depositAmount   Float       @default(500)
  status          TripStatus  @default(DRAFT)
  bookings        Booking[]  
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

enum TripStatus {
  DRAFT
  PUBLISHED
  FULL
  COMPLETED
  CANCELLED
}

// ------------------------------------------------------
// 4. UTILISATEURS & AUTH (NexAuth standard)
// ------------------------------------------------------
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  image         String?
  role          String    @default("USER")
  
  accounts      Account[]
  sessions      Session[]
  bookings      Booking[] 

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
}

// ------------------------------------------------------
// 5. RÉSERVATIONS, LEADS & AUTH (Le reste de ton schéma)
// ------------------------------------------------------
model Booking {
  id           Int        @id @default(autoincrement())
  tripId       Int
  groupTrip    GroupTrip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userName     String
  userEmail    String
  participants Int        @default(1)
  status       String     @default("PENDING")
  createdAt    DateTime   @default(now())
  userId       String?
  user         User?      @relation(fields: [userId], references: [id])
}

model CustomLead {
  id              String      @id @default(cuid())
  firstName       String
  lastName        String
  email           String
  phone           String?
  destination     String
  budget          String
  startDate       DateTime?
  endDate         DateTime?
  dayNumber       Int?
  nightNumber     Int?
  partySize       Int
  experienceType  String
  additionalNotes String?     @db.Text
  status          LeadStatus  @default(NEW)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

enum LeadStatus {
  NEW
  CONTACTED
  PROPOSAL
  CONVERTED
  LOST
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}