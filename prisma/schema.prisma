// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// 1. DESTINATIONS & PAGES PAYS (NOUVEAU)
// ------------------------------------------------------
model Destination {
  id            String      @id @default(cuid())
  name          String      @unique
  slug          String      @unique
  tagline       String?     // "La perle des Caraïbes"
  description   String      @db.Text
  heroVideoUrl  String?
  imageUrl      String?
  currency1     String?     
  currency2     String? 

  // Relations  
  trips         GroupTrip[] // Relation avec les voyages de groupe (Niche)
  circuits      Circuit[]   // Relation avec les circuits classiques
  posts        Post[]      // Relation avec les articles de blog

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ------------------------------------------------------
// 2. VOYAGES INDIVIDUELS / CIRCUITS TYPES (Classique / Famille / StandardAU)
// ------------------------------------------------------
model Circuit {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  tagline         String?     // "Le Costa Rica en famille"
  description     String      @db.Text
  presentationImg String?
  duration        Int         
  priceBase       Float       
  pricePremium    Float?      
  pricePlatinium  Float?      
  program         Json        
  isPublished     Boolean     @default(false)

  // Relation Destination
  destinationId   String
  destination     Destination @relation(fields: [destinationId], references: [id])

  // Relation booking
  bookings        Booking[]
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// ------------------------------------------------------
// 3. VOYAGES DE GROUPE (Modifié pour la relation)
// ------------------------------------------------------
model GroupTrip {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  description     String      @db.Text
  imageUrl     String?    // Image de la carte ou miniature
  videoUrl     String?    // URL de la vidéo Hero (YouTube/Vimeo ou MP4)
  startDate       DateTime
  endDate         DateTime
  duration        Int
  capacity        Int
  program         Json        // Itinéraire détaillé
  priceBase       Float
  pricePremium    Float?
  pricePlatinium  Float?
  depositAmount   Float?
  status          TripStatus  @default(DRAFT)

  // Relation Destination
  destinationId   String
  destination     Destination @relation(fields: [destinationId], references: [id])
  
  bookings        Booking[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// ------------------------------------------------------
// 4. BLOG (Nouveau - Structure SEO & Performance)
// ------------------------------------------------------
model Post {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  excerpt         String?     @db.Text // Pour les meta-tags et cartes de liste
  content         String      @db.Text // Contenu riche (HTML/Markdown)
  mainImage       String      // Image Hero de l'article
  category        String      // Ex: "Conseils", "Récits", "Guide"
  readingTime     Int?        // Temps estimé en minutes
  
  // SEO & Social
  metaTitle       String?
  metaDescription String?
  featured        Boolean     @default(false) // Pour mise en avant sur Home/Blog
  published       Boolean     @default(false)

  // Relation Destination (Optionnel : lier un article à un pays)
  destinationId   String?
  destination     Destination? @relation(fields: [destinationId], references: [id])

  authorName      String      @default("L'équipe Authentik")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([slug])
}

// ------------------------------------------------------
// 5. ENUMS & AUTH
// ------------------------------------------------------
enum TripStatus {
  DRAFT      // En préparation (non visible sur le site)
  PUBLISHED  // En ligne et disponible
  FULL       // COMPLET (Visible mais plus de réservations possibles)
  CANCELLED  // Annulé
  COMPLETED  // Terminé (Passé)
}

enum LeadStatus {
  NEW
  CONTACTED
  PROPOSAL
  CONVERTED
  LOST
}

// ------------------------------------------------------
// 6. UTILISATEURS & AUTH (NexAuth standard)
// ------------------------------------------------------
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  image         String?
  role          String    @default("USER")
  
  // Relations
  accounts      Account[]
  sessions      Session[]
  bookings      Booking[] 

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
}

// ------------------------------------------------------
// 7. RÉSERVATIONS, LEADS & AUTH (Le reste de ton schéma)
// ------------------------------------------------------

enum BookingType {
  GROUP      // Voyage à date fixe (ton focus actuel)
  INDIVIDUAL // Circuit catalogue acheté tel quel
  CUSTOM     // Circuit sur-mesure validé après devis
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

model Booking {
  id              Int           @id @default(autoincrement())
  type            BookingType   @default(GROUP)
  
  // POLYMORPHISME : Liens vers les différents produits
  groupTripId     String?       // Rempli si c'est un voyage de groupe
  groupTrip       GroupTrip?    @relation(fields: [groupTripId], references: [id])
  
  circuitId       String?       // Rempli si c'est un circuit individuel
  circuit         Circuit?      @relation(fields: [circuitId], references: [id])

  // INFOS CLIENT (Prénom + Nom séparés comme demandé)
  firstName       String
  lastName        String
  email           String
  phone           String?

  // DÉTAILS DU SÉJOUR
  startDate       DateTime
  endDate         DateTime
  participants    Int           @default(1)
  optionType      String        // "BASE", "PREMIUM", "PLATINIUM"
  
  // FINANCE
  totalPrice      Float
  amountPaid      Float         @default(0)
  paymentMethod   String        // "STRIPE", "VIREMENT", "CHEQUE"
  status          BookingStatus @default(PENDING)

  // RELATION AUTH
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// ------------------------------------------------------
// 8. RÉSERVATIONS, LEADS & AUTH (Le reste de ton schéma)
// ------------------------------------------------------
model CustomLead {
  id              String      @id @default(cuid())
  firstName       String
  lastName        String
  email           String
  phone           String?
  destination     String
  budget          String
  startDate       DateTime?
  endDate         DateTime?
  dayNumber       Int?
  nightNumber     Int?
  partySize       Int
  experienceType  String
  additionalNotes String?     @db.Text
  status          LeadStatus  @default(NEW)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}


model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}