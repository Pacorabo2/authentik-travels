// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// 1. DESTINATIONS & PAGES PAYS (NOUVEAU)
// ------------------------------------------------------
model Destination {
  id            String      @id @default(cuid())
  name          String      @unique
  slug          String      @unique
  tagline       String?     // "La perle des Caraïbes"
  description   String      @db.Text
  heroVideoUrl  String?
  imageUrl      String?
  currency1     String?     
  currency2     String?     
  trips         GroupTrip[] // Relation avec les voyages de groupe (Niche)
  circuits      Circuit[]   // Relation avec les circuits classiques
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ------------------------------------------------------
// 2. VOYAGES INDIVIDUELS / CIRCUITS TYPES (Classique / Famille / StandardAU)
// ------------------------------------------------------
model Circuit {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  tagline         String?     // "Le Costa Rica en famille"
  description     String      @db.Text
  presentationImg String?
  duration        Int         
  priceBase       Float       
  pricePremium    Float?      
  pricePlatinium  Float?      
  program         Json        
  isPublished     Boolean     @default(false)
  destinationId   String
  destination     Destination @relation(fields: [destinationId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// ------------------------------------------------------
// 3. VOYAGES DE GROUPE (Modifié pour la relation)
// ------------------------------------------------------
model GroupTrip {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  description     String      @db.Text
  imageUrl     String?    // Image de la carte ou miniature
  videoUrl     String?    // URL de la vidéo Hero (YouTube/Vimeo ou MP4)
  startDate       DateTime
  endDate         DateTime
  duration        Int
  capacity        Int
  program         Json        // Itinéraire détaillé
  priceBase       Float
  pricePremium    Float?
  pricePlatinium  Float?
  depositAmount   Float?
  status          TripStatus  @default(DRAFT)
  destinationId   String
  destination     Destination @relation(fields: [destinationId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  bookings        Booking[]
}

enum TripStatus {
  DRAFT      // En préparation (non visible sur le site)
  PUBLISHED  // En ligne et disponible
  FULL       // COMPLET (Visible mais plus de réservations possibles)
  CANCELLED  // Annulé
  COMPLETED  // Terminé (Passé)
}

// ------------------------------------------------------
// 4. UTILISATEURS & AUTH (NexAuth standard)
// ------------------------------------------------------
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  image         String?
  role          String    @default("USER")
  
  accounts      Account[]
  sessions      Session[]
  bookings      Booking[] 

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
}

// ------------------------------------------------------
// 5. RÉSERVATIONS, LEADS & AUTH (Le reste de ton schéma)
// ------------------------------------------------------
model Booking {
  id           Int        @id @default(autoincrement())
  tripId       String
  groupTrip    GroupTrip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userName     String
  userEmail    String
  participants Int        @default(1)
  status       String     @default("PENDING")
  createdAt    DateTime   @default(now())
  userId       String?
  user         User?      @relation(fields: [userId], references: [id])
}

model CustomLead {
  id              String      @id @default(cuid())
  firstName       String
  lastName        String
  email           String
  phone           String?
  destination     String
  budget          String
  startDate       DateTime?
  endDate         DateTime?
  dayNumber       Int?
  nightNumber     Int?
  partySize       Int
  experienceType  String
  additionalNotes String?     @db.Text
  status          LeadStatus  @default(NEW)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

enum LeadStatus {
  NEW
  CONTACTED
  PROPOSAL
  CONVERTED
  LOST
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}